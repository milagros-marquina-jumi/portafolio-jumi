{
	"name": "portafolio-jumi",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"lint": "biome check .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"fix": "biome check --write --unsafe . && biome format --write .",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"emailjs-com": "^3.2.0",
		"gsap": "^3.15.0",
		"i18next": "^26.4.2",
