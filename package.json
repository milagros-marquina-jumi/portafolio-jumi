		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.13",
		"react-router-dom": "^7.18.4",
		"react-spinners": "^0.17.1",
		"styled-components": "^6.5.3",
		"sweetalert2": "^11.4.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.0.4",
		"globals": "^17.12.0",
		"typescript": "~5.7.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	},
